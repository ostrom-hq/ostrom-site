{
  "name": "@ostrom-hq/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/defer-runtime.ts out && node scripts/csp.ts out",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "links": "node scripts/check-links.ts out",
    "weight": "node scripts/page-weight.ts out 2000",
    "lighthouse": "lhci autorun",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "serve": "node scripts/serve.ts out 3000",
    "sync:openapi": "node scripts/sync-openapi.ts"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-string": "3.0.1",
    "mdast-util-to-hast": "13.2.1",
    "minisearch": "7.2.0",
    "next": "16.4.3",
    "posthog-js": "1.438.24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.16.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
