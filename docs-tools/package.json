{
  "name": "@ostrom-hq/docs-tools",
  "private": true,
  "type": "module",
  "description": "Lints the documentation and runs its code blocks against the real binary and server.",
  "license": "Apache-2.0",
  "engines": {"node": ">=24"},
  "scripts": {
    "lint:docs": "node bin/docs-tools.mjs lint ../content/docs",
    "test:docs": "node bin/docs-tools.mjs run ../content/docs",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/"
  }
}
